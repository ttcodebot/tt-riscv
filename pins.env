# Upstream sources every image is built from. Change a pin, rebuild, re-test on silicon, then release.
# Sourced by scripts/*.sh and by CI (bash: `. ./pins.env`).

# KianV RISC-V SoC software (Hirosh Dabui). patches/kianRiscV/ applies on top of this commit.
KIANRISCV_REPO=https://github.com/splinedrive/kianRiscV
KIANRISCV_COMMIT=8e918247860dd3d63558fe2e2cdaccbf7fccea12
# Pinned inside kianRiscV itself (listed here for reference):
#   Buildroot 851edd247f5e2e8e10f943c52218bc54c657688f   (asic/os/ulinux_asic_kianv_soc/Makefile)
#   MicroPython v1.29.0 0fd6c573ea815774668bbb16b8e197c8822368b2 (asic/os/zephyr_kianv_asic/Makefile)

# Zephyr revision for the KianV Zephyr port (the port defaults to "main").
ZEPHYR_COMMIT=29d3d75b7ef638a5323815fa94f78af54c96d1a5

# KianV 16 MiB PSRAM memtest (POST bootloader).
MEMTEST_REPO=https://github.com/urish/kianv-memtest-16m-gpio
MEMTEST_COMMIT=d7486e95ea0e267dd45d47c806779b7111c04a99

# TinyQV MicroPython for ttsky25a (Mike Bell), mirrored as-is.
TINYQV_MICROPYTHON_URL=https://tt.rebel-lion.uk/ttsky25a-tinyqv/micropython20260728.bin
TINYQV_MICROPYTHON_SHA256=e3468a98dc884533d5b80fce3b8d2f6480a9e1fbd6e6f448e1cc7ad507355632

# TinyQV C toolchain and SDK (Mike Bell), used by examples/tinyqv-breakout. Toolchain 16.1.0-tqv-2.1
# or newer is needed: older builds miscompress mul16 when its output register is the second operand.
TINYQV_TOOLCHAIN_URL=https://github.com/MichaelBell/riscv-gnu-toolchain/releases/download/16.1.0-tqv-2.1/riscv32ec-16.1.0-tqv-2.1.tar.gz
TINYQV_TOOLCHAIN_SHA256=19b13180cda6bd1526a559b5cda4310693185210e3054c457b14f1b1558ca798
TINYQV_SDK_REPO=https://github.com/MichaelBell/tinyQV-sdk
TINYQV_SDK_COMMIT=132ccb1372c2aefd2947abd6315fab93bb86713c

# Rust nightly used by every Rust build here (kianRiscV rust_nostd/rust_std and examples/rust).
RUST_NIGHTLY=nightly-2026-11-17

# KianV clock / UART the images are built for (ttsky25a: 30 MHz).
KIANV_CPU_FREQ=30000000
KIANV_BAUDRATE=115200
